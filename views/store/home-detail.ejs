<%- include('../partials/head') %>
    <!-- Razorpay Checkout SDK -->
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        .price-breakdown {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            display: none;
        }
        .price-breakdown.active {
            display: block;
        }
        .price-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.9375rem;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }
        .price-total {
            display: flex;
            justify-content: space-between;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }
        .badge-secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-top: 14px;
            font-size: 0.8125rem;
            color: #059669;
            font-weight: 500;
        }
        .btn-loading {
            opacity: 0.7;
            pointer-events: none;
            position: relative;
        }
    </style>
    </head>

    <body>
        <%- include('../partials/nav') %>

            <div class="page-container" style="max-width: 1100px;">
                <!-- Hero Image -->
                <div class="detail-hero animate-fade-in">
                    <% if (home.photoUrl) { %>
                        <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>">
                        <% } else { %>
                            <div
                                style="width:100%;height:480px;background:linear-gradient(135deg,#f0f0f0,#e0e0e0);display:flex;align-items:center;justify-content:center;color:#b0b0b0;font-size:1.25rem;">
                                No image available</div>
                            <% } %>
                </div>

                <div class="detail-layout">
                    <!-- Left Column — Details -->
                    <div class="animate-fade-in-up">
                        <div
                            style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 8px;">
                            <div>
                                <h1 style="font-size:1.75rem; font-weight:700; letter-spacing:-0.5px;">
                                    <%= home.houseName %>
                                </h1>
                                <div class="card-location" style="font-size:1rem; margin-top:4px;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                        <circle cx="12" cy="10" r="3" />
                                    </svg>
                                    <%= home.location %>
                                </div>
                            </div>
                            <div class="card-rating" style="font-size:1rem; gap:6px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFB400">
                                    <path
                                        d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                </svg>
                                <strong>
                                    <%= home.rating %>
                                </strong>
                                <span style="color:var(--text-secondary);">· 24 reviews</span>
                            </div>
                        </div>

                        <!-- Trust Badges -->
                        <div style="display:flex; gap:8px; margin:16px 0 0;">
                            <span class="badge badge-superhost">★ Superhost</span>
                            <span class="badge badge-verified">✓ Verified</span>
                            <span class="badge badge-safety">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                </svg>
                                Safety
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="detail-section">
                            <h3>About this home</h3>
                            <p style="color:var(--text-secondary); line-height:1.7;">
                                <%= home.description
                                    || 'This beautiful property offers an unforgettable experience. Enjoy comfortable amenities, stunning views, and a perfect location for your next getaway.'
                                    %>
                            </p>
                        </div>

                        <!-- Amenities -->
                        <div class="detail-section">
                            <h3>What this place offers</h3>
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:8px;">
                                <div style="display:flex; align-items:center; gap:12px; color:var(--text-secondary);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5">
                                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                                        <line x1="8" y1="21" x2="16" y2="21" />
                                        <line x1="12" y1="17" x2="12" y2="21" />
                                    </svg>
                                    Wi-Fi
                                </div>
                                <div style="display:flex; align-items:center; gap:12px; color:var(--text-secondary);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5">
                                        <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z" />
                                    </svg>
                                    Air conditioning
                                </div>
                                <div style="display:flex; align-items:center; gap:12px; color:var(--text-secondary);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5">
                                        <rect x="2" y="7" width="20" height="15" rx="2" ry="2" />
                                        <polyline points="17 2 12 7 7 2" />
                                    </svg>
                                    Kitchen
                                </div>
                                <div style="display:flex; align-items:center; gap:12px; color:var(--text-secondary);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="1.5">
                                        <circle cx="12" cy="12" r="10" />
                                        <polyline points="12 6 12 12 16 14" />
                                    </svg>
                                    Free parking
                                </div>
                            </div>
                        </div>

                        <!-- Wishlist -->
                        <div class="detail-section">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <%- include('../partials/favourite') %>
                                    <span style="font-size:0.9375rem; color:var(--text-secondary);">Save to your
                                        wishlist</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column — Booking Card -->
                    <div class="animate-fade-in-up stagger-2">
                        <div class="booking-card">
                            <div class="booking-card-price">
                                ₹<span id="nightlyRateDisplay"><%= home.price.toLocaleString() %></span> <span>/ night</span>
                            </div>

                            <div style="display:flex; align-items:center; gap:6px; margin-bottom:20px;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="#FFB400">
                                    <path
                                        d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                                </svg>
                                <strong style="font-size:0.875rem;">
                                    <%= home.rating %>
                                </strong>
                                <span style="color:var(--text-secondary);font-size:0.875rem;">· 24 reviews</span>
                            </div>

                            <% if (isLoggedIn) { %>
                                <form id="bookingPaymentForm" onsubmit="event.preventDefault(); initiateRazorpayBooking();">
                                    <input type="hidden" id="houseId" value="<%= home._id %>" />

                                    <div
                                        style="border:1.5px solid var(--border); border-radius:var(--radius-sm); overflow:hidden; margin-bottom:16px;">
                                        <div
                                            style="display:grid; grid-template-columns:1fr 1fr; border-bottom:1.5px solid var(--border);">
                                            <div style="padding:10px 12px; border-right:1.5px solid var(--border);">
                                                <label
                                                    style="display:block; font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Check-in</label>
                                                <input type="date" id="checkInInput" required
                                                    style="border:none;outline:none;font-size:0.875rem;width:100%;font-family:var(--font);color:var(--text-primary);background:transparent;" />
                                            </div>
                                            <div style="padding:10px 12px;">
                                                <label
                                                    style="display:block; font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Check-out</label>
                                                <input type="date" id="checkOutInput" required
                                                    style="border:none;outline:none;font-size:0.875rem;width:100%;font-family:var(--font);color:var(--text-primary);background:transparent;" />
                                            </div>
                                        </div>
                                        <div style="padding:10px 12px;">
                                            <label
                                                style="display:block; font-size:0.625rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Guests</label>
                                            <input type="number" id="guestsInput" min="1" max="10" value="1"
                                                style="border:none;outline:none;font-size:0.875rem;width:100%;font-family:var(--font);color:var(--text-primary);background:transparent;" />
                                        </div>
                                    </div>

                                    <!-- Live Price Breakdown -->
                                    <div id="priceBreakdown" class="price-breakdown">
                                        <div class="price-row">
                                            <span>₹<%= home.price.toLocaleString() %> × <span id="nightsCountDisplay">1</span> nights</span>
                                            <span>₹<span id="subtotalDisplay">0</span></span>
                                        </div>
                                        <div class="price-row">
                                            <span>Service fee</span>
                                            <span>₹0</span>
                                        </div>
                                        <div class="price-total">
                                            <span>Total (INR)</span>
                                            <span>₹<span id="grandTotalDisplay">0</span></span>
                                        </div>
                                    </div>

                                    <div id="paymentAlert" style="display:none; margin: 12px 0; padding: 10px 14px; border-radius: 8px; font-size: 0.875rem;"></div>

                                    <button type="submit" id="payButton" class="btn btn-primary btn-full" style="padding:14px; margin-top: 14px;">
                                        <span id="btnText">Reserve & Pay with Razorpay</span>
                                    </button>
                                </form>

                                <div class="badge-secure">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                    Secured by Razorpay Test Gateway
                                </div>
                            <% } else { %>
                                <div style="text-align:center; padding: 20px 0;">
                                    <p style="font-size:0.875rem; color:var(--text-secondary); margin-bottom:16px;">
                                        Please sign in to reserve this home</p>
                                    <a href="/login" class="btn btn-primary btn-full"
                                        style="padding:14px; text-decoration:none;">
                                        Sign in to Reserve
                                    </a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                const unitPrice = <%= home.price %>;
                const checkInEl = document.getElementById('checkInInput');
                const checkOutEl = document.getElementById('checkOutInput');
                const breakdownEl = document.getElementById('priceBreakdown');
                const nightsCountEl = document.getElementById('nightsCountDisplay');
                const subtotalEl = document.getElementById('subtotalDisplay');
                const grandTotalEl = document.getElementById('grandTotalDisplay');
                const payButton = document.getElementById('payButton');
                const btnText = document.getElementById('btnText');
                const paymentAlert = document.getElementById('paymentAlert');

                // Set min date to today
                if (checkInEl && checkOutEl) {
                    const todayStr = new Date().toISOString().split('T')[0];
                    checkInEl.min = todayStr;
                    checkOutEl.min = todayStr;

                    function updatePriceEstimate() {
                        const inVal = checkInEl.value;
                        const outVal = checkOutEl.value;
                        if (!inVal || !outVal) {
                            breakdownEl.classList.remove('active');
                            return;
                        }

                        const d1 = new Date(inVal);
                        const d2 = new Date(outVal);
                        const diffTime = d2.getTime() - d1.getTime();
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                        if (diffDays > 0) {
                            const total = diffDays * unitPrice;
                            nightsCountEl.textContent = diffDays;
                            subtotalEl.textContent = total.toLocaleString();
                            grandTotalEl.textContent = total.toLocaleString();
                            breakdownEl.classList.add('active');
                        } else {
                            breakdownEl.classList.remove('active');
                        }
                    }

                    checkInEl.addEventListener('change', () => {
                        if (checkInEl.value) {
                            const nextDay = new Date(checkInEl.value);
                            nextDay.setDate(nextDay.getDate() + 1);
                            checkOutEl.min = nextDay.toISOString().split('T')[0];
                        }
                        updatePriceEstimate();
                    });

                    checkOutEl.addEventListener('change', updatePriceEstimate);
                }

                function showAlert(msg, isError = true) {
                    if (!paymentAlert) return;
                    paymentAlert.style.display = 'block';
                    paymentAlert.style.backgroundColor = isError ? '#FEF2F2' : '#ECFDF5';
                    paymentAlert.style.color = isError ? '#991B1B' : '#065F46';
                    paymentAlert.style.border = isError ? '1px solid #FCA5A5' : '1px solid #A7F3D0';
                    paymentAlert.textContent = msg;
                }

                async function initiateRazorpayBooking() {
                    const houseId = document.getElementById('houseId').value;
                    const checkIn = checkInEl.value;
                    const checkOut = checkOutEl.value;
                    const guests = document.getElementById('guestsInput').value || 1;

                    if (!checkIn || !checkOut) {
                        showAlert('Please select both check-in and check-out dates.');
                        return;
                    }

                    // UI Loading State
                    payButton.disabled = true;
                    payButton.classList.add('btn-loading');
                    btnText.textContent = 'Creating Secure Order...';
                    paymentAlert.style.display = 'none';

                    try {
                        // 1. Create order on backend (Server calculates price)
                        const res = await fetch('/api/payments/create-order', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Accept': 'application/json'
                            },
                            body: JSON.stringify({
                                houseId,
                                checkIn,
                                checkOut,
                                guests
                            })
                        });

                        const resText = await res.text();
                        let data;
                        try {
                            data = JSON.parse(resText);
                        } catch (e) {
                            throw new Error('Server returned unexpected response (status ' + res.status + '). Please ensure the backend server was restarted.');
                        }

                        if (!res.ok || !data.success) {
                            throw new Error(data.message || 'Failed to create order.');
                        }

                        btnText.textContent = 'Complete Payment in Modal...';

                        // 2. Open Razorpay Checkout Modal
                        const options = {
                            key: data.keyId,
                            amount: data.amount,
                            currency: data.currency,
                            name: 'Airbnb Stays',
                            description: `Booking for ${data.propertyDetails.houseName} (${data.propertyDetails.nightCount} nights)`,
                            order_id: data.orderId,
                            prefill: {
                                name: data.prefill.name || '',
                                email: data.prefill.email || ''
                            },
                            theme: {
                                color: '#FF385C'
                            },
                            handler: async function (response) {
                                btnText.textContent = 'Verifying Payment...';
                                try {
                                    // 3. Verify Payment with backend
                                    const verifyRes = await fetch('/api/payments/verify-payment', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'Accept': 'application/json'
                                        },
                                        body: JSON.stringify({
                                            razorpay_order_id: response.razorpay_order_id,
                                            razorpay_payment_id: response.razorpay_payment_id,
                                            razorpay_signature: response.razorpay_signature,
                                            bookingId: data.bookingId
                                        })
                                    });

                                    const verifyText = await verifyRes.text();
                                    let verifyData;
                                    try {
                                        verifyData = JSON.parse(verifyText);
                                    } catch (e) {
                                        throw new Error('Payment verification returned invalid server response.');
                                    }

                                    if (verifyRes.ok && verifyData.success) {
                                        showAlert('Payment successful! Redirecting to your trips...', false);
                                        setTimeout(() => {
                                            window.location.href = verifyData.redirectUrl || '/bookings';
                                        }, 1500);
                                    } else {
                                        throw new Error(verifyData.message || 'Payment verification failed.');
                                    }
                                } catch (verErr) {
                                    showAlert('Error verifying payment: ' + verErr.message);
                                    resetButton();
                                }
                            },
                            modal: {
                                ondismiss: function() {
                                    showAlert('Payment cancelled or closed. You can retry when ready.', true);
                                    resetButton();
                                }
                            }
                        };

                        const rzp = new Razorpay(options);
                        rzp.on('payment.failed', function (response) {
                            showAlert('Payment Failed: ' + (response.error.description || 'Unknown error'));
                            resetButton();
                        });
                        rzp.open();

                    } catch (err) {
                        showAlert(err.message);
                        resetButton();
                    }
                }

                function resetButton() {
                    payButton.disabled = false;
                    payButton.classList.remove('btn-loading');
                    btnText.textContent = 'Reserve & Pay with Razorpay';
                }
            </script>

            <%- include('../partials/footer') %>
    </body>

    </html>